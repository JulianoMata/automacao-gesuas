# Quebras de linha padrão
* text=auto eol=lf

# Scripts do Windows
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Código-fonte Python e documentação
*.py text diff=python eol=lf
*.md text diff=markdown eol=lf
*.json text eol=lf
*.txt text eol=lf
*.spec text eol=crlf

# Arquivos Binários
*.xlsx binary
*.pdf binary
*.ico binary
*.png binary
*.exe binary
